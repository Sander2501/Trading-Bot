# ── Alpaca credentials ────────────────────────────────────────────────────────
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# ── Asset & timeframe ─────────────────────────────────────────────────────────
SYMBOL=BTC/USD
TIMEFRAME=1Min

# ── Strategy: EMA crossover + RSI filter ─────────────────────────────────────
# Fast/slow EMA windows for the crossover signal
FAST_WINDOW=9
SLOW_WINDOW=21

# Number of bars the crossover must persist before a signal fires
CONFIRM_BARS=2

# RSI filter: block BUY when RSI > overbought, block SELL when RSI < oversold
RSI_WINDOW=14
RSI_OVERBOUGHT=75
RSI_OVERSOLD=25

# ── Risk management ───────────────────────────────────────────────────────────
# Fraction of current equity to risk per trade
RISK_PER_TRADE=0.02

# Exit long position when price drops this far below entry
STOP_LOSS_PCT=0.02

# Halt trading for the day when intraday drawdown exceeds this threshold
MAX_DAILY_LOSS_PCT=0.03

# ── Timing ────────────────────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60

# ── Risk firewall ─────────────────────────────────────────────────────────────
# Sentinel file: `touch KILL_SWITCH` to halt all trading; `rm` to resume.
KILL_SWITCH_FILE=KILL_SWITCH
# Halt for the rest of the week if drawdown vs Monday's equity exceeds this
MAX_WEEKLY_LOSS_PCT=0.06
# Cool down if a fill comes back with realised slippage above this (bps)
MAX_SLIP_BPS=50
SLIPPAGE_HALT_SECONDS=600

# ── Data integrity / Telemetry ───────────────────────────────────────────────
DATA_INTEGRITY_GATE_ENABLED=true
DATA_MAX_BAR_AGE_SECONDS=0   # 0 = use 4× TIMEFRAME default
TELEMETRY_ENABLED=true
TELEMETRY_FILE=bot_telemetry.jsonl

# ── Backtest settings ─────────────────────────────────────────────────────────
BACKTEST_CSV=historical_data.csv
BACKTEST_STARTING_CASH=100000
