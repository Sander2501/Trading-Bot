# ── Alpaca credentials ────────────────────────────────────────────────────────
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# ── Asset & timeframe ─────────────────────────────────────────────────────────
SYMBOL=BTC/USD
TIMEFRAME=1Min

# ── Strategy: EMA crossover + RSI filter ─────────────────────────────────────
# Fast/slow EMA windows for the crossover signal
FAST_WINDOW=9
SLOW_WINDOW=21

# Number of bars the crossover must persist before a signal fires
CONFIRM_BARS=1

# RSI filter: block BUY when RSI > overbought, block SELL when RSI < oversold
RSI_WINDOW=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Legacy single-MA window (passed through for backward compat; not used by
# the EMA crossover strategy)
WINDOW=20

# ── Risk management ───────────────────────────────────────────────────────────
# Fraction of current equity to risk per trade
RISK_PER_TRADE=0.02

# Exit long position when price drops this far below entry
STOP_LOSS_PCT=0.02

# Halt trading for the day when intraday drawdown exceeds this threshold
MAX_DAILY_LOSS_PCT=0.03

# ── Timing ────────────────────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60

# ── Backtest settings ─────────────────────────────────────────────────────────
BACKTEST_CSV=historical_data.csv
BACKTEST_STARTING_CASH=100000
